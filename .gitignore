# Etat Terraform : contient des informations sensibles.
*.tfstate
*.tfstate.*
.terraform/
*.tfplan

# Valeurs et secrets propres a la machine.
terraform.tfvars
*.auto.tfvars
ansible/inventaire/hosts.yml
ansible/*.retry
vault-pass.txt

# Caches locaux des outils, regeneres a chaque execution.
.ansible/
.cache/

# Images constructeur et gabarits de machines. Volumineux, et leur licence
# n'autorise pas la redistribution.
*.qcow2
*.vhd
*.vhdx
*.vmdk
*.iso
*.zip
*.img
FFW_VM64_*
PA-VM-*

# Artefacts de compilation LaTeX.
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Systeme.
.DS_Store

/Docs/.claude
/rapport


