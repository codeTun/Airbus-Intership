#ps1_sysnative
# Amorcage joue une seule fois par cloudbase-init, au premier demarrage.
# Il pose l'identite, le reseau et l'acces SSH. Le reste appartient a Ansible.

$ErrorActionPreference = "Stop"
$journal = "C:\Windows\Temp\amorcage-labo.log"
Start-Transcript -Path $journal -Append

Set-TimeZone -Id "${fuseau_horaire_windows}"

if ($env:COMPUTERNAME -ne "${nom}") {
    Rename-Computer -NewName "${nom}" -Force
}

# L'interface est reconnue par son adresse MAC, fixee par Terraform.
$macCible = "${mac}".Replace(":", "-").ToUpper()
$carte = Get-NetAdapter | Where-Object { $_.MacAddress -eq $macCible }

if (-not $carte) {
    throw "Aucune interface ne porte l'adresse $macCible."
}

Remove-NetIPAddress -InterfaceIndex $carte.ifIndex -Confirm:$false -ErrorAction SilentlyContinue
Remove-NetRoute      -InterfaceIndex $carte.ifIndex -Confirm:$false -ErrorAction SilentlyContinue
Set-NetIPInterface   -InterfaceIndex $carte.ifIndex -Dhcp Disabled

New-NetIPAddress -InterfaceIndex $carte.ifIndex `
                 -IPAddress "${ip}" `
                 -PrefixLength ${masque} `
                 -DefaultGateway "${passerelle}"

Set-DnsClientServerAddress -InterfaceIndex $carte.ifIndex `
                           -ServerAddresses @(${dns_powershell})

# Windows refuse un compte local sans mot de passe. Celui-ci ne sert que de
# secours par la console : l'authentification par mot de passe est coupee plus bas.
$motDePasse = ConvertTo-SecureString "${admin_mot_de_passe}" -AsPlainText -Force

if (-not (Get-LocalUser -Name "${admin_utilisateur}" -ErrorAction SilentlyContinue)) {
    New-LocalUser -Name "${admin_utilisateur}" `
                  -Password $motDePasse `
                  -PasswordNeverExpires `
                  -AccountNeverExpires
}

# Groupe designe par son SID : son nom est traduit selon la langue de Windows.
$administrateurs = (Get-LocalGroup -SID "S-1-5-32-544").Name
Add-LocalGroupMember -Group $administrateurs -Member "${admin_utilisateur}" -ErrorAction SilentlyContinue

# A integrer au gabarit de preference : sinon cette etape demande Internet.
if ((Get-WindowsCapability -Online -Name "OpenSSH.Server*").State -ne "Installed") {
    Add-WindowsCapability -Online -Name "OpenSSH.Server~~~~0.0.1.0"
}

Set-Service -Name sshd -StartupType Automatic
Start-Service -Name sshd

# Sans cette cle de registre, Ansible enverrait ses commandes au shell cmd.
New-ItemProperty -Path "HKLM:\SOFTWARE\OpenSSH" `
                 -Name DefaultShell `
                 -Value "C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe" `
                 -PropertyType String -Force | Out-Null

# Les comptes administrateurs lisent leur cle ici, pas dans leur profil.
$clesAdmin = "C:\ProgramData\ssh\administrators_authorized_keys"
Set-Content -Path $clesAdmin -Value "${cle_ssh_publique}" -Encoding ascii
icacls $clesAdmin /inheritance:r /grant "SYSTEM:F" /grant "$administrateurs:F" | Out-Null

$config = "C:\ProgramData\ssh\sshd_config"
(Get-Content $config) `
    -replace '^#?PasswordAuthentication.*', 'PasswordAuthentication no' `
    -replace '^#?PubkeyAuthentication.*',   'PubkeyAuthentication yes' |
    Set-Content $config

Restart-Service -Name sshd

# Le pare-feu Windows refuse deja l'entrant. Seul SSH est ouvert ici, les
# services metiers le seront par leurs roles Ansible.
if (-not (Get-NetFirewallRule -Name "labo-ssh" -ErrorAction SilentlyContinue)) {
    New-NetFirewallRule -Name "labo-ssh" `
                        -DisplayName "SSH (administration du laboratoire)" `
                        -Direction Inbound -Protocol TCP -LocalPort 22 `
                        -Action Allow -Profile Any | Out-Null
}

$dossier = "C:\ProgramData\labo-airbus"
New-Item -Path $dossier -ItemType Directory -Force | Out-Null

@"
nom: ${nom}
adresse: ${ip}
amorcage: cloudbase-init
"@ | Set-Content -Path "$dossier\identite.yaml" -Encoding utf8

New-Item -Path "$dossier\amorcage-termine" -ItemType File -Force | Out-Null

Stop-Transcript
