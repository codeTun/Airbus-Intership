# Adressage fixe, conforme au plan d'adressage.
# L'interface est reconnue par son adresse MAC, son nom variant selon le
# type de machine emule.
version: 2
ethernets:
  principale:
    match:
      macaddress: "${mac}"
    set-name: eth0
    dhcp4: false
    dhcp6: false
    addresses: ["${ip}/${masque}"]
    routes:
      - to: default
        via: ${passerelle}
    nameservers:
      search: ["${domaine_dns}"]
      addresses: ${jsonencode(dns)}
