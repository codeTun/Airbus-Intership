#cloud-config
# ${nom} : ${description}
# Amorcage seulement. L'installation des services revient a Ansible.

hostname: ${nom}
fqdn: ${nom}.${domaine_dns}
prefer_fqdn_over_hostname: true

users:
  - name: ${admin_utilisateur}
    gecos: Administrateur du laboratoire
    groups: [sudo, adm]
    shell: /bin/bash
    lock_passwd: true
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${cle_ssh_publique}

disable_root: true
ssh_pwauth: false

timezone: ${fuseau_horaire}
ntp:
  enabled: true
  ntp_client: chrony
  servers: ${jsonencode(serveurs_ntp)}

package_update: true
packages:
  - qemu-guest-agent
  - chrony
  - ufw
  - unattended-upgrades
  - python3
  - python3-apt

write_files:
  # Le fichier d'echange ne sert pas en fonctionnement normal. Il evite
  # qu'un pic ponctuel n'oblige le noyau a arreter un processus.
  - path: /etc/sysctl.d/99-labo.conf
    content: |
      vm.swappiness = 10
    permissions: "0644"

  - path: /etc/apt/apt.conf.d/20auto-upgrades
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
    permissions: "0644"

  - path: /etc/labo-airbus.yaml
    content: |
      machine: ${nom}
      role: ${description}
      adresse: ${ip}
      amorcage: cloud-init
      configuration: ansible
    permissions: "0644"

swap:
  filename: /swapfile
  size: 2147483648
  maxsize: 2147483648

runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]
  - [systemctl, enable, --now, chrony]
  - [sysctl, --system]

  # Seul SSH est ouvert ici. Chaque role Ansible ouvre ensuite les ports
  # dont son service a besoin.
  - [ufw, default, deny, incoming]
  - [ufw, default, allow, outgoing]
  - [ufw, allow, "22/tcp"]
  - [ufw, --force, enable]

  - [touch, /var/lib/cloud/instance/amorcage-termine]

final_message: "${nom} amorce apres $UPTIME secondes, pret pour Ansible"
