#!/bin/bash
# Genere par Ansible, role pointeuses. Ne pas modifier a la main.
# Sauvegarde quotidienne de la base des pointages. Une interruption de
# collecte fait perdre des donnees qu'on ne peut pas reconstituer.
set -euo pipefail

REPERTOIRE="{{ pointeuses_sauvegarde_repertoire }}"
HORODATAGE=$(date +%Y%m%d-%H%M)
FICHIER="${REPERTOIRE}/{{ pointeuses_base }}-${HORODATAGE}.sql.gz"

mkdir -p "$REPERTOIRE"
sudo -u postgres pg_dump {{ pointeuses_base }} | gzip > "$FICHIER"
chmod 0600 "$FICHIER"

# Purge des sauvegardes au-dela de la retention.
find "$REPERTOIRE" -name '{{ pointeuses_base }}-*.sql.gz' \
     -mtime +{{ pointeuses_sauvegarde_retention_jours }} -delete

logger -t sauvegarde-pointages "sauvegarde terminee : $FICHIER"
