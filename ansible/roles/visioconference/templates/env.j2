{# Genere par Ansible, role visioconference. Ne pas modifier a la main. #}
{# Variables limitees a celles documentees dans env.example du projet. #}
CONFIG={{ visioconference_config }}
TZ={{ fuseau_horaire }}
PUBLIC_URL=https://{{ visioconference_domaine }}
RESTART_POLICY=unless-stopped

HTTP_PORT=80
HTTPS_PORT={{ visioconference_port_web }}

# Adresse annoncee aux clients pour les flux media. Sans elle, le videobridge
# annonce l'adresse interne du conteneur et les appels restent muets.
JVB_ADVERTISE_IPS={{ ansible_host }}

# Secure Domain : creation de salle reservee aux comptes declares.
ENABLE_AUTH={{ 1 if visioconference_authentification else 0 }}
ENABLE_GUESTS={{ 1 if visioconference_invites else 0 }}
AUTH_TYPE=internal

JICOFO_AUTH_PASSWORD={{ coffre_visio_jicofo_auth }}
JVB_AUTH_PASSWORD={{ coffre_visio_jvb_auth }}
